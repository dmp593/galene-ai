# galene-ai configuration — copy this file to `.env` and fill in your values.
#
#   cp .env.example .env
#
# `.env` is gitignored; this `.env.example` is committed as a template.
# The SDK auto-loads `.env` from the working directory when a client is
# constructed. Real environment variables always take precedence over `.env`.
# Every setting below is optional — the SDK and the Makefile fall back to sane
# defaults when a value is absent.

# =============================================================================
# SDK settings (read at runtime by the client)
# =============================================================================

# API key used by the default ApiKeyAuth (sent as `Authorization: Bearer <key>`).
# Leave unset only if you construct the client with an explicit auth handler.
GALENE_AI_API_KEY=your-api-key-here

# Base URL of the Galene deployment to talk to.
# Defaults to the public playground when unset: https://api.playground.galene.ai
# Point it at your own instance, e.g. https://galene.your-company.example
GALENE_AI_BASE_URL=https://api.playground.galene.ai

# =============================================================================
# Publishing tokens (only used by `make publish` / `make publish-test`)
# =============================================================================
# PyPI and TestPyPI disabled username/password uploads — you MUST use an API
# token. `make publish*` passes it via `uv publish --token`, which sends the
# username `__token__` for you (no interactive prompt).
#
# PyPI and TestPyPI are SEPARATE accounts, so each needs its OWN token. Paste
# the raw token value (it starts with `pypi-`), with no surrounding quotes.
#
# Real PyPI token — get one at: https://pypi.org/manage/account/token/
# PYPI_TOKEN=pypi-AgEIcHlwaS5vcmcC...

# TestPyPI token — get one at: https://test.pypi.org/manage/account/token/
# TEST_PYPI_TOKEN=pypi-AgEIcHlwaS5vcmcC...

# =============================================================================
# Test & dev knobs (optional)
# =============================================================================
# Models used by the live integration suite (`make test-live`). Override if your
# deployment exposes different model names.
# GALENE_TEST_MODEL=Galene/LLM
# GALENE_TEST_EMBED_MODEL=Galene/Embedding

# Dev-only: keep importing the remaining resource modules even if one fails to
# import (used when validating namespaces in isolation). Leave unset normally.
# GALENE_DEV_RESILIENT_IMPORT=1
